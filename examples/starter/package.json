{
  "name": "workerpress-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler versions upload -c dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "typecheck": "astro check",
    "cms": "workerpress"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.4",
    "@astrojs/svelte": "^8.1.1",
    "@hono/zod-validator": "^0.8.0",
    "@workerpress/cloudflare": "workspace:*",
    "@workerpress/core": "workspace:*",
    "@workerpress/ui": "workspace:*",
    "astro": "^6.3.7",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "svelte": "^5.55.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@libsql/client": "^0.17.3",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}
