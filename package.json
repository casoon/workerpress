{
  "name": "workerpress",
  "version": "0.0.0",
  "private": true,
  "description": "Schema-getriebenes Edge-Application-Framework mit CMS-Fokus (Astro + Hono auf Cloudflare Workers)",
  "type": "module",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace examples/starter",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^13.5.4",
    "@astrojs/svelte": "^8.1.1",
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "astro": "^6.3.7",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
